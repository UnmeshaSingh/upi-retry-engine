# UPI Retry Engine — Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME="UPI Retry Engine"
APP_VERSION="0.1.0"
DEBUG=True

# Redis (local development)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# PostgreSQL (local development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=upi_retry_db
DB_USER=postgres
DB_PASSWORD=postgres